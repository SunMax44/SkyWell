FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for geospatial and scientific Python packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gdal-bin \
        libgdal-dev \
        proj-bin \
        proj-data \
        libproj-dev \
        gcc \
        g++ \
        python3-dev \
        ca-certificates \
        curl \
        make \
        libexpat1 \
        && rm -rf /var/lib/apt/lists/*

# Set GDAL environment variables (sometimes needed for rasterio/rioxarray)
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY etl/ ./etl/

ENTRYPOINT ["sh", "-c", "python etl/fetch_uv_data.py && python etl/fetch_cams_air_data.py"] 